#!/usr/bin/env bash
set -Eeuo pipefail
# Resolve symlinks so /usr/local/bin/server-admin can find /opt/server-admin/lib.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"; export SERVER_ADMIN_ROOT="$ROOT"
source "$ROOT/lib/common.sh"
cmd=${1:-help}; shift || true
case "$cmd" in
 add-user) source "$ROOT/lib/add_user.sh"; add_user "$@";;
 create-shared-project) source "$ROOT/lib/create_shared_project.sh"; create_shared_project "$@";;
 disable-cloud-init-ssh) source "$ROOT/lib/disable_cloud_init_ssh.sh"; disable_cloud_init_ssh "$@";;
 setup-ssh) source "$ROOT/lib/setup_ssh.sh"; setup_ssh "$@";;
 verify-user) source "$ROOT/lib/verify_user.sh"; verify_user "$@";;
 remove-user) source "$ROOT/lib/remove_user.sh"; remove_user "$@";;
 list-users) source "$ROOT/lib/list_users.sh"; list_users;;
 show-keys) source "$ROOT/lib/show_keys.sh"; show_keys;;
 doctor) source "$ROOT/lib/doctor.sh"; doctor;;
 info) source "$ROOT/lib/info.sh"; info;;
 version) echo "server-admin $APP_VERSION";;
 help|-h|--help) cat <<'EOF'
server-admin - Ubuntu GPU server administration

Usage: server-admin <command> [options]
  add-user [--username NAME] [--sudo|--no-sudo] [--key FILE]
  create-shared-project [options]
  disable-cloud-init-ssh
  setup-ssh [options]
  verify-user [NAME|--all]   remove-user [NAME]
  list-users            show-keys
  doctor                info
  version               help
EOF
 ;;
 *) fail "Unknown command: $cmd"; echo "Run 'server-admin help' for usage."; exit 2;;
esac
